@using GestaoDeEquipamentosWeb.ConsoleApp.Models
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Fabricante";

}

@model ExcluirFabricanteViewModel;

<h1>Gestão de Equipamentos TK</h1>

<h2>Exclusão de Fabricante</h2>

<form class="formulario-action" action="/Fabricante/Editar/@Model.Id" method="post">
    <div>
        <label>Nome: </label><br />
        <input type="text" name="Nome" value="@Model.Nome" disabled>
    </div>
    <div>
        <label>Email: </label><br />
        <input type="text" name="Email" value="@Model.Email" disabled>
    </div>
    <div>
        <label>Telefone: </label><br />
        <input type="" name="Telefone" value="@Model.Telefone" disabled>
    </div>

    <button type="submit">Confirmar</button>
</form>