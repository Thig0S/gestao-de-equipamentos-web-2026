@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Fabricantes";

}
@using GestaoDeEquipamentosWeb.ConsoleApp.Models

@model List<ListarFabricantesViewModel>

<h1>Gestão de Equipamentos TK</h1>

<h2>Listar Fabricantes</h2>
<hr>
<a href="/Fabricante/Cadastrar">Cadastrar Fabricante</a>
</hr>
<hr>

<table>
    <thead>
        <tr>
            <td>ID</td>
            <td>Nome</td>
            <td>Email</td>
            <td>Telefone</td>
            <td>Ações</td>
        </tr>
    </thead>

    <tbody>
        #@foreach(ListarFabricantesViewModel f in Model){
        <tr>
            <td>@f.Id</td>
            <td>@f.Nome</td>
            <td>@f.Email</td>
            <td>@f.Telefone</td>
            <td><a href="/Fabricante/Editar/@f.Id">Editar</a></td>
            <td><a href="/Fabricante/Excluir/@f.Id">Excluir</a></td>
        </tr>
    }
</tbody>
</table>