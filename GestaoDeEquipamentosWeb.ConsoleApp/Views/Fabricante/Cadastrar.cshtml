@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Fabricante";

}
<h1>Gestão de Equipamentos TK</h1>

<h2>Cadastro de Fabricante</h2>

<form class="formulario-action" action="/Fabricante/Cadastrar" method="post">
    <div>
        <label>Nome: </label><br />
        <input type="text" name="Nome">
    </div>
    <div>
        <label>Email: </label><br />
        <input type="text" name="Email">
    </div>
    <div>
        <label>Telefone: </label><br />
        <input type="" name="Telefone">
    </div>

    <button type="submit">Confirmar</button>
</form>