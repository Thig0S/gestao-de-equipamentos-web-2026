@{
    Layout = "_Layout";
    ViewBag.Titulo = "Editar Chamado";

    List<SelectListItem> selecionarEquipamentos = ViewBag.Equipamentos;
}
@model EditarChamadoViewModel;

<form class="formulario-action" asp-action="Editar" asp-route-id="@Model.Id" method="post">
    <div>
        <label asp-for="Titulo">Titulo: </label><br />
        <input asp-for="Titulo" type="text">
        <span asp-validation-for="Titulo" class="formulario-validacao-campo"></span>
    </div>
    <div>
        <label asp-for="Descricao">Descrição: </label><br />
        <textarea class="text-input" asp-for="Descricao" type="text" maxlength="500"></textarea>
        <span asp-validation-for="Descricao" class="formulario-validacao-campo"></span>
    </div>
    <div>
        <label asp-for="EquipamentoId">Equipamentos: </label><br />
        <select asp-for="EquipamentoId" asp-items="selecionarEquipamentos">
            <option value="">Selecione o Equipamento</option>
        </select>
        <span asp-validation-for="EquipamentoId" class="formulario-validacao-campo"></span>
    </div>
    <div class="formulario-campo">
        <label asp-for="EstaConcluido">Status</label>
        <label>
            <input asp-for="EstaConcluido" type="checkbox">
            Concluir Chamado
        </label>
    </div>
    <button type="submit">Confirmar</button>

</form>