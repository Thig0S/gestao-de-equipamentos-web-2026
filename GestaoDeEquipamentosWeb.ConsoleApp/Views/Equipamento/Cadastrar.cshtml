@{

    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Equipamentos";

    List<ListarFabricantesViewModel> fabricantes = ViewBag.Fabricantes;

}

@model List<ListarEquipamentosViewModel>

<h2>Cadastro de Equipamento</h2>

<form class="formulario-action" action="/Equipamento/Cadastrar" method="post">
    <div>
        <label>Nome: </label><br />
        <input type="text" name="Nome">
    </div>
    <div>
        <label>Preço de Aquisição: </label><br />
        <input type="number" name="PrecoAquisicao" min="0.01" step="0.01">
    </div>
    <div>
        <label>Data de Fabricação: </label><br />
        <input type="date" name="DataFabricacao">
    </div>
    <div>
        <label>Fabricante: </label><br />
        <select name="FabricanteId">
            @foreach (ListarFabricantesViewModel f in fabricantes)
            {
                <option value="@f.Id">@f.Nome</option>
            }
        </select>
    </div>

    <button type="submit">Confirmar</button>
</form>